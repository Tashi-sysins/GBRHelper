<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.6" />
    <Compile Include="../GBRHelper/Navigation/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../GBRHelper/Navigation/SmoothNav/*.cs" Link="SmoothNav/%(Filename)%(Extension)" />
    <Compile Include="../GBRHelper/Navigation/Bridge/*.cs" Link="Bridge/%(Filename)%(Extension)" />
    <Compile Include="../GBRHelper/Navigation/NavigationTraceWriter.cs" Link="NavigationTraceWriter.cs" />
    <Compile Include="../GBRHelper/Ipc/LoadedPluginBinding.cs" Link="LoadedPluginBinding.cs" />
    <Compile Include="../GBRHelper/Navigation/FrameworkRouteQueries.cs" Link="FrameworkRouteQueries.cs" />
    <None Update="TestData/*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
